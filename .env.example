# Application ID from the LRCLIB developer portal (server-side registration).
# Always sent together with LRCLIB_API_KEY; upstream rejects it alone (401).
# Treat as a secret: set via `wrangler secret put LRCLIB_APP_ID` in production.
LRCLIB_APP_ID=
# Secret API key from the LRCLIB developer portal (server-side registration).
# Optional: the publish proxy skips the header when unset.
# Production: set via `wrangler secret put LRCLIB_API_KEY` instead of this file.
LRCLIB_API_KEY=
